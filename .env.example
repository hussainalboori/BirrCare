# Birrcare environment configuration
# Copy to `.env` (git-ignored) and fill in. Docker Compose reads `.env` from the
# repo root automatically and passes these values to the containers.
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Household
# -----------------------------------------------------------------------------

# IANA time zone of the household. Used for "today" (dose scheduling) and the
# doctor export. Without it the container runs in UTC and early-morning doses
# can land on the wrong day.
APP_TIMEZONE=Asia/Riyadh

# -----------------------------------------------------------------------------
# Cloudflare Access (Zero Trust)
# -----------------------------------------------------------------------------
# When both are set, the backend verifies the signed Cf-Access-Jwt-Assertion
# token and signs in the caregiver whose email matches. If either is empty,
# Cloudflare sign-in is disabled and only PIN login works.

# Your team domain, without https:// (Zero Trust → Settings → Custom Pages).
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# Application Audience (AUD) tag (Zero Trust → Access → Applications → your app).
CF_ACCESS_AUD=

# Trust the raw Cf-Access-Authenticated-User-Email header without verifying the
# JWT. Spoofable by anything that can reach the backend. Leave false.
CF_ACCESS_TRUST_EMAIL_HEADER=false

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

# Key for signing PIN session cookies, at least 32 characters.
# Optional: if empty, a random key is generated on first boot and stored in the
# database. Generate one with:  openssl rand -base64 48
# Changing it signs every caregiver out.
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Development only
# -----------------------------------------------------------------------------

# Treat anonymous requests as the first active caregiver (an admin).
# Defaults to on when APP_ENV is not "production". NEVER enable in production.
AUTH_DEV_FALLBACK=false

# Comma-separated browser origins allowed to call the backend directly (CORS).
# Not needed when the frontend proxies /api/v1 (the default setup).
# Defaults to http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Set by docker-compose.yml, listed for running the services outside Docker
# -----------------------------------------------------------------------------
# Backend:   PORT=8080  DB_PATH=/data/birrcare.db
#            APP_ENV=production  (enables Secure cookies and requires login)
# Frontend:  INTERNAL_BACKEND_URL=http://birrcare-backend:8080  (proxy target)
#            NEXT_PUBLIC_API_URL=/api/v1  (browser-side API base)
