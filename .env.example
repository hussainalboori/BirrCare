# Birrcare environment configuration
# Copy to `.env` (git-ignored) and fill in. Docker Compose reads `.env` from the
# repo root automatically and passes these values to the containers.
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Initial Super Admin Account (Seeded when the database is empty)
# -----------------------------------------------------------------------------
# Name or username for the initial Super Admin account (default: admin)
SUPER_ADMIN_USER=admin

# 4-digit numeric PIN for the initial Super Admin account (default: 1234)
SUPER_ADMIN_PIN=1234

# -----------------------------------------------------------------------------
# Household
# -----------------------------------------------------------------------------

# IANA time zone of the household. Used for "today" (dose scheduling) and the
# doctor export. Without it the container runs in UTC and early-morning doses
# can land on the wrong day.
APP_TIMEZONE=Asia/Riyadh

# Shown as one-tap call buttons when a blood pressure reading is a crisis
# (>= 180 systolic or >= 120 diastolic), on the phone that logged it and on every
# sibling's phone, and on partial or vomited doses (doctor).
# EMERGENCY_NUMBER is also sent inside every page as the offline fallback, so
# the emergency button works without the server. If it is empty, the app falls
# back to 112 and admins see a "not configured" banner. After changing it, run
# ./scripts/deploy.sh restart. An empty DOCTOR_PHONE hides the doctor button.
EMERGENCY_NUMBER=997
DOCTOR_NAME=
DOCTOR_PHONE=

# -----------------------------------------------------------------------------
# Cloudflare Access (Zero Trust)
# -----------------------------------------------------------------------------
# When both are set, the backend verifies the signed Cf-Access-Jwt-Assertion
# token and signs in the caregiver whose email matches. If either is empty,
# Cloudflare sign-in is disabled and only PIN login works.

# Your team domain, without https:// (Zero Trust → Settings → Custom Pages).
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# Application Audience (AUD) tag (Zero Trust → Access → Applications → your app).
CF_ACCESS_AUD=

# Trust the raw Cf-Access-Authenticated-User-Email header without verifying the
# JWT. Spoofable by anything that can reach the backend. Leave false.
CF_ACCESS_TRUST_EMAIL_HEADER=false

# -----------------------------------------------------------------------------
# Lock-screen alerts (Web Push)
# -----------------------------------------------------------------------------
# Crisis and important medication alerts are pushed to phones that turned
# alerts on (home screen app on iOS 16.4+, Chrome on Android). The keys are
# generated on first boot and stored in the database. Push services want a
# contact for the sender: a mailto: or https: URL. Empty uses the project URL.
PUSH_CONTACT=

# -----------------------------------------------------------------------------
# One-tap switching at home (issue #29)
# -----------------------------------------------------------------------------
# The home's public internet address (as Cloudflare sees it), so phones at home
# can switch caregiver with one tap. Comma-separated IPs, or CIDR ranges in
# TRUSTED_HOME_SUBNETS. A paired bedside device is more reliable (it survives
# the router getting a new address). Leave empty if your provider shares one
# public IP between many homes (CGNAT): everyone behind it would be trusted.
# One tap only reaches caregiver accounts; admins always enter their PIN.
TRUSTED_HOME_IP=
TRUSTED_HOME_SUBNETS=
# -----------------------------------------------------------------------------
# Where the website listens
# -----------------------------------------------------------------------------
# 127.0.0.1: only this server can reach it (the Cloudflare Tunnel connector,
# cloudflared, runs on this server). 0.0.0.0: also the local network, for a
# connector running on another machine (e.g. another container). The backend
# always stays on 127.0.0.1.
WEB_BIND=127.0.0.1
# -----------------------------------------------------------------------------
# Public address (used by scripts/deploy.sh only)
# -----------------------------------------------------------------------------
# After a deploy, deploy.sh checks the app answers here too (through Cloudflare),
# so a broken tunnel or DNS shows up at once. Empty skips that check.
PUBLIC_URL=
# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

# Key for signing PIN session cookies, at least 32 characters.
# Optional: if empty, a random key is generated on first boot and stored in the
# database. Generate one with:  openssl rand -base64 48
# Changing it signs every caregiver out.
SESSION_SECRET=

# Break-glass for two-factor authentication. If a Super Admin loses both their
# authenticator phone and their recovery codes, set this to their caregiver id
# (e.g. cg_superadmin), restart once, then REMOVE it and restart again.
# Leaving it set disables their 2FA on every restart.
DISABLE_2FA_FOR=

# -----------------------------------------------------------------------------
# Development only
# -----------------------------------------------------------------------------

# Treat anonymous requests as the first active caregiver (an admin).
# Defaults to on when APP_ENV is not "production". NEVER enable in production.
AUTH_DEV_FALLBACK=false

# Comma-separated browser origins allowed to call the backend directly (CORS).
# Not needed when the frontend proxies /api/v1 (the default setup).
# Defaults to http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Set by docker-compose.yml, listed for running the services outside Docker
# -----------------------------------------------------------------------------
# Backend:   PORT=8080  DB_PATH=/data/birrcare.db
#            APP_ENV=production  (enables Secure cookies and requires login)
# Frontend:  INTERNAL_BACKEND_URL=http://birrcare-backend:8080  (proxy target)
#            NEXT_PUBLIC_API_URL=/api/v1  (browser-side API base)
