# User unit: install to ~/.config/systemd/user/ (see scripts/auto-deploy.sh)
[Unit]
Description=Birrcare updater (offer CI-passed updates, install on request)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/birrcare/scripts/auto-deploy.sh
TimeoutStartSec=30min
